# Copy to .env.local, or run npm run setup:local.
# Public read-only access to your own database. Never use a service-role key.
# Overrides platform-managed settings without requiring Lovable Cloud.
VITE_PORTAL_DATABASE_URL=
VITE_PORTAL_DATABASE_KEY=

# Dedicated RADIX Talent Match Auth client. Keep separate from the company client.
# Use the V2 public anon/publishable key only; never use a service-role or sb_secret key.
VITE_TALENT_MATCH_SUPABASE_URL=
VITE_TALENT_MATCH_SUPABASE_ANON_KEY=
VITE_TALENT_MATCH_API_BASE_URL=http://localhost:8000

# Local FastAPI service URL; do not put LLM provider credentials in frontend variables.
VITE_TALENT_MATCH_API_URL=http://localhost:8000
