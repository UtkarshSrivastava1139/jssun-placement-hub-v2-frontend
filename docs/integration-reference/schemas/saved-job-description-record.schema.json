{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radix.local/schemas/saved-job-description-record.schema.json",
  "title": "SavedJobDescriptionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_description_id",
    "schema_version",
    "extraction",
    "created_at"
  ],
  "properties": {
    "job_description_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "extraction": {
      "$ref": "jd-extraction-result.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
