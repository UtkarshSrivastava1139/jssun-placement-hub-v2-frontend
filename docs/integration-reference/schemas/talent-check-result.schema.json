{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radix.local/schemas/talent-check-result.schema.json",
  "title": "TalentCheckResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "profile_id",
    "company_key",
    "company_name",
    "readiness_score",
    "scoring_version",
    "created_at",
    "skillset_gap",
    "assessment_coverage",
    "evidence_coverage",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_id": {
      "type": "string",
      "format": "uuid"
    },
    "company_key": {
      "enum": [
        "google",
        "microsoft",
        "oracle_fss"
      ]
    },
    "company_name": {
      "type": "string",
      "minLength": 1
    },
    "readiness_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "scoring_version": {
      "const": "tc-v1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "skillset_gap": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_code",
          "required_level",
          "candidate_level",
          "gap_amount",
          "gap",
          "attainment",
          "learning_topics",
          "profile_evidence_status"
        ],
        "properties": {
          "category_code": {
            "enum": [
              "COD",
              "DSA",
              "OOD",
              "APTI",
              "COMM",
              "AI",
              "CLOUD",
              "SQL",
              "SWE",
              "SYSD",
              "NETW",
              "OS"
            ]
          },
          "required_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "candidate_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "gap_amount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "gap": {
            "type": "boolean"
          },
          "attainment": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "learning_topics": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "profile_evidence_status": {
            "enum": [
              "source_supported",
              "self_report_only"
            ],
            "description": "Source-supported means at least one relevant skill in this category has non-empty evidence and provenance resume_extraction, project, internship, or certification. This is document/profile support, not independent verification of competence."
          }
        }
      }
    },
    "assessment_coverage": {
      "type": "number",
      "const": 1.0
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories_with_gap",
        "strongest_categories",
        "interpretation_notice",
        "categories_with_profile_evidence"
      ],
      "properties": {
        "categories_with_gap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "strongest_categories": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "enum": [
              "COD",
              "DSA",
              "OOD",
              "APTI",
              "COMM",
              "AI",
              "CLOUD",
              "SQL",
              "SWE",
              "SYSD",
              "NETW",
              "OS"
            ]
          }
        },
        "interpretation_notice": {
          "type": "string",
          "maxLength": 500
        },
        "categories_with_profile_evidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        }
      }
    },
    "evidence_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Number of categories with profile-source support divided by 12; informational only and does not affect readiness_score."
    }
  }
}
